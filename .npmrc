# pnpm 11.20.0 does not honour engine-strict for a mismatched Node version — verified:
# `pnpm install` under the wrong Node major only warns ([WARN] Unsupported engine) and
# exits 0, it does not fail. `scripts/check-node-version.mjs` (wired as the root
# `preinstall` script) is the check that actually binds. Keep this setting anyway: it is
# correct for npm and for a future pnpm release that honours it, and removing it risks
# someone assuming there's no gate at all rather than a different one.
engine-strict=true
