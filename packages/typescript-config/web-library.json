{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    // WebWorker, not DOM: a package built on this config must stay safe to
    // bundle for the browser (see docs/ARCHITECTURE.md §7), so it gets only
    // the narrow worker-scope globals code like hashing.ts actually needs —
    // TextEncoder and crypto.subtle — rather than DOM's much larger surface
    // (Window, document, HTMLElement, ...) that nothing here uses.
    "lib": ["ES2023", "WebWorker"]
  }
}
