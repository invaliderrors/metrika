{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "test:unit": {
      "dependsOn": ["^build", "build"],
      // test/postgres-image.test.ts is a UNIT test that reads
      // infra/docker/docker-compose.yml — outside this package. Turbo hashes
      // only a package's own files, so without this it reports success FROM
      // CACHE while the compose file it validates has drifted.
      //
      // MEASURED: prime green, change postgres:16-alpine to postgres:17-alpine,
      // re-run — same hash, exit 0. Forced, exit 1 with
      // `expected [ 'postgres:17-alpine' ] to deeply equal [ 'postgres:16-alpine' ]`.
      //
      // This was the fourth instance of the shape; the other three are in
      // apps/api, apps/web and packages/typescript-config. Any test that reads
      // a file outside its own package needs an entry here, and nothing
      // enforces that — a test added later is silently unhashed.
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/infra/docker/docker-compose.yml"]
    }
  }
}
