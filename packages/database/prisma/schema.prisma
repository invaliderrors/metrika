generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Whether an organization is the one a person is given at signup or one they
/// built to work with other people. Members and order copied from
/// `packages/contracts/src/organization.ts:44`, which copied them from
/// `docs/DOMAIN_MODEL.md:62`.
enum OrganizationKind {
  PERSONAL
  TEAM
}

/// What a person is inside ONE organization. Members and order copied from
/// `packages/contracts/src/organization.ts:55`.
///
/// NOT A RANK. Nothing here puts OWNER above ADMIN, and no policy may derive a
/// privilege ordering from enum position — see the header comment on the Zod
/// enum. Postgres does give this type an ordering (`<` works on an enum, by
/// declaration position), which is precisely why the rule is repeated here: an
/// `ORDER BY role` or a `role >= 'ADMIN'` in a future migration would be
/// accepted by the database and wrong.
///
/// `PlatformRole` is deliberately NOT here. Its only column is
/// `PlatformRoleAssignment.role`, and that table lands in Plan 1D with the
/// elevated client it authorises; a Postgres enum type with no column is a
/// schema object nothing can be wrong about.
enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  BILLING
}

/// The currency vocabulary, as a Postgres enum. Members and order copied from
/// `packages/contracts/src/money.ts:3`.
///
/// THIS IS FOR CONFIGURATION, NOT FOR STORED MONEY, and the asymmetry is
/// deliberate — see ADR-0040. `Organization.defaultCurrency` is a mutable
/// default on an Identity entity, read to decide what a NEW quote is
/// denominated in, so constraining it to today's vocabulary is correct.
/// `Money.currency` is the opposite: a persisted historical fact that must stay
/// parseable after the vocabulary changes, so it stays
/// `String @db.Char(3)` per `docs/DOMAIN_MODEL.md:491` and must NOT be
/// migrated onto this type.
enum CurrencyCode {
  COP
  USD
  EUR
  MXN
}

/// A person. The primary key is ours; `(authProvider, externalAuthId)` is the
/// mapping to the external identity provider (Clerk — ADR-0012, ADR-0038).
///
/// `User_authProvider_externalAuthId_key` is the constraint the whole sign-in
/// path turns on: it is what makes "provision on first login" idempotent by a
/// database guarantee rather than by an application check, and it is what the
/// `User_identity_bootstrap` RLS policy exists to let a caller read through
/// before any `AuthContext` can exist. See ADR-0040.
model User {
  id String @id @default(uuid(7)) @db.Uuid

  // Plain `String`, NOT a Prisma enum, and the reason is mechanical rather
  // than stylistic. `app_current_auth_provider()` returns `text`, and the
  // `User_identity_bootstrap` policy compares this column against it directly.
  // Against a Postgres enum that comparison has no operator, so it would need
  // either `"authProvider"::text = …` (a cast on a column in the hot path of
  // every request) or `… = app_current_auth_provider()::"AuthProvider"` —
  // which RAISES 22P02 for a GUC value outside the type, turning a
  // deny-by-default read into a 500 on the most-travelled path in the product.
  // There is also no `AuthProvider` vocabulary in `packages/contracts` to copy
  // members from, and inventing one is a contracts edit this slice does not
  // need. Validated at the API boundary, like the currency exponent.
  authProvider   String
  externalAuthId String

  // Lowercased by the writer, not by the database. Postgres has no
  // case-insensitive text type without `citext`, and `User_email_key` is a
  // plain unique index, so `A@x.com` and `a@x.com` are two rows as far as the
  // constraint is concerned. Task 6 owns the normalisation.
  email       String
  displayName String
  locale      String    @default("es-CO")
  timezone    String?
  deletedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  memberships          OrganizationMember[] @relation("OrganizationMemberUser")
  invitationsSent      OrganizationMember[] @relation("OrganizationMemberInvitedBy")
  personalOrganization Organization?

  // Every unique in this file is written in block form, composite or not, so
  // the constraint names the provisioning path and the RLS policies depend on
  // read together in one place.
  @@unique([authProvider, externalAuthId])
  @@unique([email])
}

/// The tenant boundary. Every user gets a PERSONAL organization at signup,
/// which removes "a resource with no organization" as a branch from every
/// policy and every query (`docs/DOMAIN_MODEL.md:62`).
model Organization {
  id String @id @default(uuid(7)) @db.Uuid

  kind            OrganizationKind
  name            String
  slug            String
  // ISO-3166-1 alpha-2, uppercase. `@db.Char(2)` follows the fixed-width code
  // precedent in `docs/DOMAIN_MODEL.md:491-493` (`Char(3)` currency,
  // `Char(64)` hash). There is no ISO-3166 vocabulary in `packages/contracts`
  // and 1A does not create one, so the member set is checked at the API
  // boundary and the width is checked here.
  countryCode     String           @db.Char(2)
  defaultCurrency CurrencyCode
  // NIT in Colombia. Stored, never used in core logic
  // (`docs/DOMAIN_MODEL.md:62`), so it carries no format constraint on
  // purpose: a wrong regex here would reject a real taxpayer.
  taxIdentifier   String?

  /// The user this organization is the personal organization OF. Unique, so a
  /// user can hold at most one — and NOT NULL is not available, because a TEAM
  /// organization has no personal owner. Postgres treats NULLs as distinct in
  /// a unique index, so the unique alone permits a PERSONAL organization with
  /// the column left NULL and therefore a user with two of them; the other
  /// half of the invariant is the `Organization_personal_owner_required` CHECK
  /// in the migration's hand-written block, which Prisma's DSL cannot express.
  ///
  /// `billingAddressId` from `docs/DOMAIN_MODEL.md:62` is deliberately absent:
  /// `Address` is not a Phase 1 table, and a nullable UUID with no referent is
  /// a fact nobody can check.
  personalOwnerUserId String? @db.Uuid

  deletedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  personalOwner User?                @relation(fields: [personalOwnerUserId], references: [id], onDelete: Restrict)
  members       OrganizationMember[]

  @@unique([slug])
  @@unique([personalOwnerUserId])
}

/// A person's membership of one organization.
///
/// NO `deletedAt`: it is not an Identity entity (`docs/DOMAIN_MODEL.md:13`),
/// and whether removal is a hard DELETE or a `removedAt` timestamp is Plan
/// 1C's decision. It is therefore absent from `SOFT_DELETABLE_MODELS`, and
/// `soft-delete-coverage.test.ts` asserts that correspondence in both
/// directions.
///
/// Its policy names no other table, and Plan 1C must keep it that way: a
/// policy here that reads `User` or `Organization` closes a cycle with the two
/// policies that already read this table, and Postgres answers a cycle with
/// `42P17 infinite recursion detected in policy for relation`. See ADR-0040.
model OrganizationMember {
  id String @id @default(uuid(7)) @db.Uuid

  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           OrganizationRole
  invitedById    String?          @db.Uuid
  // Distinct from `createdAt` on purpose: the row is created when the
  // membership is written, which for an accepted invitation (1C) is not when
  // the person joined. Defaulted so the provisioning path need not name it.
  joinedAt       DateTime         @default(now()) @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation("OrganizationMemberUser", fields: [userId], references: [id], onDelete: Restrict)
  invitedBy    User?        @relation("OrganizationMemberInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  // Load-bearing, not decoration. The composite unique above indexes
  // `(organizationId, userId)` and serves the `User` policy's EXISTS subquery,
  // which is organization-leading. The `Organization` policy's subquery is
  // user-leading (`m."userId" = app_current_user_id()`) and has no index
  // without this one — and it runs on every organization read.
  @@index([userId])
}

/// Round-trip target for GET /health/deep. It exists so the deep probe can
/// prove a real query reached Postgres and came back, rather than proving a
/// TCP connection opened. Not tenant-scoped, so no RLS policy.
model HealthCheck {
  id        String   @id @default(uuid()) @db.Uuid
  checkedAt DateTime @default(now()) @db.Timestamptz(3)
}

/// The permanent regression fixture for the two client extensions and for RLS.
///
/// It is retained on purpose rather than deleted once Phase 1 introduces real
/// tenant tables. Cost: one empty table. Benefit: the RLS and soft-delete
/// suites keep working between phases without depending on whichever domain
/// model happens to exist, and a migration that silently drops FORCE ROW LEVEL
/// SECURITY fails a test instead of shipping.
model RlsProbe {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  label          String
  deletedAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  @@index([organizationId, createdAt(sort: Desc)])
}
