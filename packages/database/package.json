{
  "name": "@metrika/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "prisma",
    "sql"
  ],
  "scripts": {
    "db:generate": "node --env-file-if-exists=../../.env ../../scripts/prisma.mjs generate",
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b --force",
    "lint": "eslint .",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@metrika/contracts": "workspace:*",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1"
  },
  "devDependencies": {
    "@metrika/eslint-config": "workspace:*",
    "@metrika/testing": "workspace:*",
    "@metrika/typescript-config": "workspace:*",
    "eslint": "10.8.0",
    "prisma": "7.9.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
