# Local development. Copy this file to `.env`:  cp .env.example .env
#
# `.env` is the ONLY local environment file. The Prisma CLI loads it natively
# and `node --env-file=.env` loads it for the API; a second `.env.local` would
# be a second way to be wrong. apps/api/test/env-example.test.ts asserts in
# CI that this file is a superset of what apps/api's Zod schema requires, so
# a fresh clone can never fail with an unexplained missing-variable error —
# that gate is enforced, not a manual discipline; letting this file drift
# fails `pnpm verify`.

NODE_ENV=development

# --- API ---
API_PORT=3001
LOG_LEVEL=debug
# Guards /health/deep, which reports per-dependency latency. Replaced by the
# Clerk guard in Phase 1; until then a shared secret is the control, and
# apps/api/test/health.integration.test.ts asserts the 401.
#
# The schema enforces a 16-character MINIMUM and nothing else — it cannot
# measure entropy, so `aaaaaaaaaaaaaaaa` passes validation and is not a secret.
# Outside local development, generate it: `openssl rand -hex 32`.
HEALTH_DEEP_TOKEN=local-health-deep-token

# --- Web ---
# READ THIS BEFORE ADDING A KEY HERE. `NEXT_PUBLIC_` is not a naming
# convention: Next replaces the literal text `process.env.NEXT_PUBLIC_<NAME>`
# with the value at BUILD time, so the value is compiled into the JavaScript
# every visitor downloads. It is public, permanently, to anyone who opens
# devtools — and it is baked into the bundle, so rotating it needs a rebuild and
# a redeploy, not a restart. Never put a secret behind this prefix. A key with
# no `NEXT_PUBLIC_` prefix is server-only and never reaches the browser; that is
# where anything sensitive goes.
#
# Where apps/web's API client points. Same origin the API serves on (API_PORT
# above), because the browser is what calls it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# The locale used until the visitor's own preference is known. One of the two
# in SUPPORTED_LOCALES (apps/web/src/config/env.ts): es-CO or en-US.
NEXT_PUBLIC_DEFAULT_LOCALE=es-CO

# --- Database ---
# Two URLs, two roles, deliberately. The API connects as metrika_app, which is
# NOSUPERUSER NOBYPASSRLS so row-level security actually applies to it.
# Migrations connect as the owner; schema.prisma names DATABASE_ADMIN_URL.
DATABASE_URL=postgresql://metrika_app:metrika_app@localhost:5432/metrika_dev?schema=public
DATABASE_ADMIN_URL=postgresql://metrika:metrika@localhost:5432/metrika_dev?schema=public

# --- Dependencies present in docker compose, wired up in later plans ---
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=metrika-local
S3_ACCESS_KEY_ID=metrika
S3_SECRET_ACCESS_KEY=metrika-local
S3_FORCE_PATH_STYLE=true
SMTP_URL=smtp://localhost:1025
