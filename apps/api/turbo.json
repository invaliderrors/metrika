{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "test:unit": {
      "dependsOn": ["^build", "build"],
      // test/env-example.test.ts reads the ROOT `.env.example` and asserts it
      // documents every key this package's env schema declares. Turbo hashes
      // only a package's own files, so without this the gate reports success
      // FROM CACHE while the file it validates has drifted.
      //
      // MEASURED on apps/api: prime green, delete two documented keys from
      // .env.example, re-run — exit 0, cache hit. The gate never ran.
      //
      // `$TURBO_ROOT$` is what lets a package's inputs reach outside its own
      // directory.
      //
      // The second entry is the same hazard on a different file.
      // test/telemetry.test.ts reads `metrika_core/telemetry.py` and asserts the
      // five strings the correlation chain crosses the language boundary on —
      // the baggage key and the three log field names. Nothing mechanical keeps
      // the two sides in agreement, and the failure is silent on both: a
      // worker's span stays correctly parented and merely loses `requestId`.
      //
      // MEASURED here too, before the entry was added: prime green, change
      // BAGGAGE_REQUEST_ID in the Python file, re-run — "cache hit, replaying
      // logs", exit 0. With the entry, the same edit misses the cache and the
      // suite goes red.
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.env.example",
        "$TURBO_ROOT$/apps/workers/packages/metrika_core/src/metrika_core/telemetry.py"
      ]
    }
  }
}
