node_modules/
dist/
.turbo/
coverage/
*.tsbuildinfo

# apps/web build output. `next-env.d.ts` is generated by `next build`/`next dev`
# and is not committed: it `import`s `./.next/types/*.d.ts`, which only exist
# after a build, so a committed copy would reference missing files in a fresh
# clone. Nothing type-checks it — apps/web/tsconfig.json's `include` does not
# name it — but leaving it untracked is what keeps `git status` clean after a
# build, which this repo's rules require.
.next/
next-env.d.ts

# Playwright's own output. `test-results/` holds the traces, screenshots and
# videos a failed run writes; `playwright-report/` is the HTML reporter's
# output. Neither is produced by a fully green default run, which is exactly why
# they are listed before anyone sees them — the first red run is a bad moment to
# discover the tree went dirty.
test-results/
playwright-report/
.env
.env.local
.DS_Store
.venv/
__pycache__/
.pytest_cache/
.mypy_cache/

# agent scratch — ledgers, briefs, review packages
.superpowers/

# stray output an interrupted `packages/typescript-config` test run can leave behind
packages/typescript-config/test/.tmp-nest-out/
packages/typescript-config/test/next-fixtures/page.js
